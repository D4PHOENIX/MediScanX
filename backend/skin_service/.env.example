# ==============================================================================
# MediScanX - Skin Service Configuration
# ==============================================================================
# This file is used for local standalone development of the Skin Service.
# ==============================================================================

# --- Model Configuration ---
# Paths to model weights (defaults to local ./weights or container /weights)
SKIN_WEIGHTS_PATH=./weights/skin_multidomain_weights.pth

# Hardware configuration
DEVICE=cpu

# --- Engine Settings ---
NUM_CLASSES=8
IMAGE_SIZE=224
MELANOMA_TRIAGE_THRESHOLD=0.20
ENABLE_OTSU_ROI=True
