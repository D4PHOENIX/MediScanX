# ==============================================================================
# MediScanX - ECG Service Configuration
# ==============================================================================
# This file is used for local standalone development of the ECG Service.
# ==============================================================================

# --- Model Configuration ---
# Model paths (local development typically mounts or places weights in ./weights)
ECG_ONNX_PATH=./weights/ecg_v2_12lead.onnx
ECG_CKPT_PATH=./weights/ecg_v2_12lead.ckpt

# Hardware configuration
DEVICE=cpu

# --- Engine Settings ---
# Model configuration
NUM_LEADS=12
NUM_CLASSES=5

# --- Application Configuration ---
HOST=0.0.0.0
PORT=8002
