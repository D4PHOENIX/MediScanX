# ==============================================================================
# MediScanX - Agent Service Configuration
# ==============================================================================
# This file is used for local standalone development of the Agent Service.
# ==============================================================================

# --- API Keys & LLM Configuration ---
# Provide your Gemini Developer API key here for LangChain
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_MODEL=gemini-2.0-flash

# --- Google Cloud (Optional) ---
# Used if authenticating via service account instead of direct API keys
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# --- Database & State ---
# Connection strings for local development databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_db
SUPABASE_URL=https://your-supabase-project-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Downstream Microservices URLs ---
# Configured for local standalone execution (localhost instead of internal docker DNS)
CXR_SERVICE_URL=http://localhost:8001/predict
ECG_SERVICE_URL=http://localhost:8002/predict
SKIN_SERVICE_URL=http://localhost:8003/predict

# --- Server Settings ---
HOST=0.0.0.0
PORT=8005
