# ==============================================================================
# MediScanX - Gateway Backend Configuration
# ==============================================================================
# This file is used for local standalone development of the Gateway Service.
# ==============================================================================

# --- Application Configuration ---
PORT=8000
DEV_MODE=False
DEV_TOKEN_SECRET=your_super_secure_dev_bypass_token_here
ALLOWED_ORIGINS=https://mediscanx.app,http://localhost:3000
MAX_UPLOAD_BYTES=20971520

# --- Supabase Configuration ---
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-key
SUPABASE_ANON_KEY=your-anon-key
# --- Database (asyncpg pool — scan_results persistence) ---
# Format: postgresql://user:password@host:port/db
# For Supabase: use the "Session" pooler URL (port 5432) in production.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Downstream Microservices URLs ---
CXR_SERVICE_URL=http://localhost:8001
ECG_SERVICE_URL=http://localhost:8002
SKIN_SERVICE_URL=http://localhost:8003
AGENT_SERVICE_URL=http://localhost:8005


# --- Supabase Storage ---
# The pre-existing Storage bucket name for uploaded scan images.
SUPABASE_STORAGE_BUCKET=scan-images
ANDROID_CERT_FINGERPRINTS=your-android-cert-fingerprint-here

# --- Claim / Report Tokens ---
CLAIM_BASE_URL=https://mediscanx.app/claim
REPORT_TOKEN_SECRET=your_super_secure_report_token_here

# --- Gemini API Key (for LLM / Agent Service) ---
GEMINI_API_KEY=your-gemini-api-key-here