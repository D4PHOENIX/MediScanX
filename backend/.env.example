# ==============================================================================
# MediScanX - Root Configuration
# ==============================================================================
# This file is used specifically by `docker-compose.yml` to pass global
# secrets down to the individual containers.
#
# Instructions:
# 1. Copy this file to `.env` in the root directory:
#    cp .env.example .env
# 2. Fill in the required values below before running:
#    docker-compose up --build -d
#
# Note: For running services standalone (e.g., `uv run uvicorn`), please
# refer to the specialized `.env` file inside each microservice's directory.
# ==============================================================================

# ==============================================================================
# 1. GATEWAY BACKEND
# ==============================================================================
# Required Auth / DB Variables
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key
SUPABASE_SECRET_KEY=your-secure-random-secret-key-here
# Gateway backend — Session Pooler (port 5432).
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Agent service — Session Pooler (port 5432, same host as above, different port).
# AsyncPostgresSaver (psycopg3) uses PREPARE internally; transaction pooler is incompatible.
AGENT_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Optional Configuration (Defaults provided internally if omitted)
PORT=8000
DEV_MODE=False
DEV_TOKEN_SECRET=your_super_secure_dev_bypass_token_here
ALLOWED_ORIGINS=https://mediscanx.app
MAX_UPLOAD_BYTES=20971520
SUPABASE_STORAGE_BUCKET=scan-images

# Internal Routing Overrides (Required for docker-compose internal network)
AGENT_SERVICE_URL=http://agent_service:8005
CXR_SERVICE_URL=http://cxr_service:8001
ECG_SERVICE_URL=http://ecg_service:8002
SKIN_SERVICE_URL=http://skin_service:8003

# ==============================================================================
# 2. AGENT SERVICE
# ==============================================================================
# Required LLM / Processing Variables
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Configuration
GOOGLE_MODEL=gemini-3.5-flash
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# HF_TOKEN=your-huggingface-token-here

# ==============================================================================
# 3. CHEST X-RAY SERVICE (CXR)
# ==============================================================================
# Optional overrides (Defaults are configured for docker-compose volume mounts)
# CXR_WEIGHTS_PATH=/weights/best_densenet_cihmlc.pth
# CXR_THRESHOLDS_PATH=/weights/best_thresholds.npy
# HEATMAP_BETA=0.4
# COLORMAP=2

# ==============================================================================
# 4. ECG SERVICE
# ==============================================================================
# Optional overrides (Defaults are configured for docker-compose volume mounts)
# ECG_ONNX_PATH=/models/mediscanx_ecg_3rdexp_finetuned.onnx
# ECG_CKPT_PATH=/models/mediscanx_ecg_3rdexp_finetuned.ckpt
# CLASSIFICATION_THRESHOLD=0.5

# ==============================================================================
# 5. SKIN SERVICE
# ==============================================================================
# Optional overrides (Defaults are configured for docker-compose volume mounts)
# SKIN_WEIGHTS_PATH=/weights/skin_weights.pt
# DEVICE=cpu

# ==============================================================================
# 6. CLOUDFLARED TUNNEL
# ==============================================================================
# Required for zero-trust routing inbound
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
